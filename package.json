{
  "name": "jisr",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --filter @jisr/dashboard typecheck",
    "test": "vitest run",
    "check:banned": "tsx scripts/check-banned.ts",
    "doctor": "tsx --env-file-if-exists=.env scripts/doctor.ts",
    "test:watch": "vitest",
    "dev:gateway": "pnpm --filter @jisr/gateway dev",
    "dev:dashboard": "pnpm --filter @jisr/dashboard dev",
    "dev:worker": "pnpm --filter @jisr/worker dev",
    "db:generate": "pnpm --filter @jisr/db generate",
    "db:migrate": "pnpm --filter @jisr/db migrate",
    "seed": "tsx --env-file-if-exists=.env seed/seed.ts",
    "stickers": "tsx --env-file-if-exists=.env scripts/generate-stickers.ts",
    "language-test": "tsx --env-file-if-exists=.env scripts/language-test.ts",
    "drill:model-outage": "tsx --env-file-if-exists=.env scripts/drill-model-outage.ts",
    "drill:sla-timeout": "tsx --env-file-if-exists=.env scripts/drill-sla-timeout.ts",
    "drill:webhook-replay": "tsx --env-file-if-exists=.env scripts/drill-webhook-replay.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "zod": "3.25.76",
    "qrcode": "1.5.4",
    "@types/qrcode": "1.5.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs",
      "sharp",
      "@depot/cli"
    ],
    "overrides": {
      "zod": "3.25.76",
      "undici": ">=6.27.0",
      "ws": ">=8.21.0"
    }
  }
}
