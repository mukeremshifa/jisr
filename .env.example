# ---------------------------------------------------------------------------
# Jisr — copy to .env and fill in. NEVER commit .env (it is gitignored).
# Every value here is intentionally empty. No real secrets, no real numbers.
# ---------------------------------------------------------------------------

# Public URLs
COMPANY_NAME=Al Noor Contracting
# Set after seeding: the company that Slack interactions resolve to.
DEFAULT_COMPANY_ID=
PUBLIC_GATEWAY_URL=
PUBLIC_DASHBOARD_URL=

# OpenAI (take model IDs from the current docs)
OPENAI_API_KEY=
OPENAI_REASONING_MODEL=
OPENAI_TRANSCRIBE_MODEL=
OPENAI_TTS_MODEL=

# OpenRouter fallback (comma-separated, in order)
OPENROUTER_API_KEY=
OPENROUTER_FALLBACK_MODELS=

# Google Cloud
GOOGLE_CLOUD_PROJECT=
GCS_BUCKET=

# Exa
EXA_API_KEY=
EXA_ALLOWED_DOMAINS=u.ae,mohre.gov.ae

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
WHATSAPP_NUMBER_DIGITS=

# Trigger.dev
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# CopilotKit Channels
INTELLIGENCE_API_KEY=
# Jisr handles workers' personal data; CopilotKit's runtime telemetry is off by default.
COPILOTKIT_TELEMETRY_DISABLED=true

# Slack fallback (only if needed)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=

# Slack routing. Per-site channels live in the `sites` table; these are the
# company-wide fallbacks used when a site has none.
SLACK_DEFAULT_CHANNEL_ID=
SLACK_SPEAKUP_CHANNEL_ID=
SLACK_SAFETY_CHANNEL_ID=
SLACK_ESCALATION_CHANNEL_ID=

# Auth0: dashboard login
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=

# Auth0: CIBA (a separate application with the CIBA grant enabled)
AUTH0_CIBA_CLIENT_ID=
AUTH0_CIBA_CLIENT_SECRET=
AUTH0_CIBA_AUDIENCE=
# push | email  — email needs a longer expiry, see docs/decisions.md
AUTH0_CIBA_CHANNEL=push

# Auth0 FGA
FGA_API_URL=
FGA_STORE_ID=
FGA_MODEL_ID=
FGA_CLIENT_ID=
FGA_CLIENT_SECRET=
FGA_API_TOKEN_ISSUER=
FGA_API_AUDIENCE=

# Ambiguous
AMBIGUOUS_MCP_URL=https://app.ambiguous.ai/mcp
AMBIGUOUS_API_KEY=
AMBIGUOUS_PAYROLL_SHEET=Payroll adjustments

# Database
DATABASE_URL=
DATABASE_URL_MIGRATOR=

# Crypto (32-byte keys, base64 — generate with: openssl rand -base64 32)
DATA_ENCRYPTION_KEY=
SEALING_KEY=
PHONE_HMAC_KEY=

# Demo venue (Site B geofence)
VENUE_LAT=
VENUE_LNG=

# Behaviour
DEMO_SLA_MINUTES=3
PAY_OT_MULTIPLIER_BP=12500
PAY_NIGHT_OT_MULTIPLIER_BP=15000
DAILY_TOKEN_BUDGET=
FEATURE_TAP_TO_REPORT=true
FEATURE_SPEAKUP=true
FEATURE_PAY_TWO_PERSON=true
FEATURE_DASHBOARD_COPILOT=true
FEATURE_AMBIGUOUS_TASKS=false

# Usage caps (all optional, defaults in packages/core/config.ts)
CAP_INBOUND_PER_WORKER_PER_HOUR=20
CAP_AUDIO_SECONDS_PER_WORKER_PER_DAY=600
CAP_AUDIO_SECONDS_PER_MESSAGE=180
CAP_IMAGE_BYTES=10485760
CAP_AUDIO_BYTES=16777216

# Test/demo switches (never set in production)
FORCE_LLM_FALLBACK=false
